# Copy to .env.local for development. Use hosted secrets in Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/devhub?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Optional, but recommended to increase the GitHub API allowance.
GITHUB_TOKEN=""
